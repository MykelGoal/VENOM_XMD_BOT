# ─── VENOM-XMD Configuration ───────────────────────────────
# Copy this file to ".env" and fill in your values.

# Bot identity
BOT_NAME=VENOM-XMD
PREFIX=.

# Owner number(s) in international format, no "+", comma-separated
# Example: 2348012345678,2349087654321
OWNER_NUMBER=

# Login method: "qr" | "pairing" | "both"
LOGIN_METHOD=both

# Phone number for pairing-code login (international format, no "+")
# Required only when LOGIN_METHOD is "pairing" or "both"
PAIRING_NUMBER=

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Command cooldown per user (milliseconds)
COOLDOWN_MS=3000

# ─── AI (optional) ─────────────────────────────────────────
# Provider currently supported out of the box: "openai" (or any
# OpenAI-compatible endpoint like Groq, OpenRouter, Together, etc.)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
# Optional: auto-reply with AI to normal (non-command) DMs. true/false
AI_AUTO_REPLY=false

# ─── Sticker ───────────────────────────────────────────────
STICKER_PACK=VENOM-XMD
STICKER_AUTHOR=venom
