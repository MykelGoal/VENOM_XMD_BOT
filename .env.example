# ─── VENOM-XMD Configuration ───────────────────────────────
# Copy this file to ".env" and fill in your values.

# Bot identity
BOT_NAME=VENOM-XMD
PREFIX=.

# Owner number(s) in international format, no "+", comma-separated
# Example: 2348012345678,2349087654321
OWNER_NUMBER=

# ─── Session (recommended for deploys) ─────────────────────
# Pair ONCE on the VENOM session site, then paste the session ID here.
# With SESSION_ID set, the bot starts pre-authenticated — no QR scan on
# the server. Leave it blank to use the QR / pairing flow below instead.
#
# Accepts any of:
#   • Short  →  VENOM-XXXX-XXXX          (recommended; permanent, cloud-backed)
#   • Long   →  VENOM~....                (self-contained, works offline)
#   • Plain  →  eyJ...                    (base64 creds, legacy)
SESSION_ID=

# Only needed for the SHORT (VENOM-XXXX-XXXX) session ID — the URL of your
# deployed session site, so the bot can fetch/refresh its credentials.
# Example: https://your-session-site.onrender.com
SESSION_SITE_URL=

# Login method (used only when SESSION_ID is blank): "qr" | "pairing" | "both"
LOGIN_METHOD=both

# Phone number for pairing-code login (international format, no "+")
# Required only when LOGIN_METHOD is "pairing" or "both"
PAIRING_NUMBER=

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Command cooldown per user (milliseconds)
COOLDOWN_MS=3000

# ─── AI (optional) ─────────────────────────────────────────
# Provider: "openai" (OpenAI-compatible: Groq/OpenRouter/etc.) OR "gemini"
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
# Optional: auto-reply with AI to normal (non-command) DMs. true/false
AI_AUTO_REPLY=false

# ─── Gemini (only if AI_PROVIDER=gemini) ───────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ─── Sticker ───────────────────────────────────────────────
STICKER_PACK=VENOM-XMD
STICKER_AUTHOR=venom
