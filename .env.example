# ─── VENOM-XMD Configuration ───────────────────────────────
# Copy this file to ".env" and fill in your values.
#
# ★ BASIC BOOT NEEDS SESSION_ID + OWNER_NUMBER. ★
# Production/redeploy reliability also needs MONGO_URI + AUTH_STATE_SECRET so
# the complete WhatsApp Signal-key state is encrypted and restored.
# ───────────────────────────────────────────────────────────

# ─── 1) SESSION_ID  (REQUIRED for server deploys) ──────────
# Pair ONCE at:  https://session-site-2odn.onrender.com
# then paste the session ID it gives you here. The bot starts
# pre-authenticated — no QR scan on the server.
#
# Accepts any of:
#   • Short  →  VENOM-XXXX-XXXX          (recommended; permanent, cloud-backed)
#   • Long   →  VENOM~....                (self-contained, works offline)
#   • Plain  →  eyJ...                    (base64 creds, legacy)
SESSION_ID=

# ─── 2) OWNER_NUMBER  (REQUIRED) ───────────────────────────
# Your number(s), international format, no "+", comma-separated.
# Without this you cannot use owner/admin commands. Example:
#   2348012345678,2349087654321
OWNER_NUMBER=

# ═══════════════════════════════════════════════════════════
#  EVERYTHING BELOW IS OPTIONAL — safe to leave untouched.
# ═══════════════════════════════════════════════════════════

# Bot identity
BOT_NAME=VENOM-XMD
PREFIX=.

# Banner image shown at the top of .menu (as the image caption).
# Leave blank to use the bundled assets/logo.png. Set a URL to use your own.
MENU_IMAGE_URL=

# Session site URL — already points at the public VENOM session site.
# Only change this if you self-host your own session generator.
SESSION_SITE_URL=https://session-site-2odn.onrender.com

# Strong random secret used to AES-256-GCM encrypt the complete Baileys auth
# archive before MongoDB storage. Generate once (e.g. `openssl rand -base64 32`)
# and keep it stable across redeploys. SESSION_ID is used only as a fallback.
AUTH_STATE_SECRET=

# Login method (used only when SESSION_ID is blank): "qr" | "pairing" | "both"
LOGIN_METHOD=both

# Phone number for pairing-code login (international format, no "+")
# Required only when LOGIN_METHOD is "pairing" and SESSION_ID is blank.
PAIRING_NUMBER=

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Command cooldown per user (milliseconds)
COOLDOWN_MS=3000

# ─── AI (optional) — MULTI-PROVIDER with automatic fallback ─
# Add a key for ANY of the providers below. The bot tries them in AI_ORDER
# and uses the first that answers, so if one is down/out of quota it falls
# back to the next. IMPORTANT: put keys HERE (or in your host dashboard),
# NEVER in the source code — leaked keys pushed to GitHub get auto-revoked.
#
# Fallback order (only providers that have a key are tried):
AI_ORDER=deepseek,gemini,openrouter,groq,openai
# Top-preference provider (optional).
AI_PROVIDER=deepseek
# Auto-reply with AI to normal (non-command) DMs. true/false
AI_AUTO_REPLY=false

# DeepSeek — https://platform.deepseek.com  (cheap, strong)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Google Gemini — free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-flash-latest auto-tracks the newest Flash model (recommended)
GEMINI_MODEL=gemini-flash-latest

# OpenRouter — https://openrouter.ai  (gateway to many models, has FREE ones)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free

# Groq — https://console.groq.com  (very fast, generous free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Generic OpenAI-compatible (OpenAI itself, or any compatible endpoint)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Gemini or OpenAI also powers `.imagine`; image generation falls back only
# between legitimately configured first-party providers.

# Third-party public Free Fire profile lookup (optional). Prefer private setup:
#   .setkey freefire YOUR_API_KEY
FREEFIRE_API_KEY=
FREEFIRE_FALLBACK_BASES=https://free-ff-api-src-5plp.onrender.com

# ─── VTU shop (optional) ───────────────────────────────────
# ClubKonnect fulfils data; Flutterwave optionally collects customer wallet
# top-ups by bank transfer. Prefer private runtime setup:
#   .setkey clubkonnect USERID|APIKEY
#   .setkey flutterwave FLWSECK-...
# Never put real credentials in source control. These are env fallbacks only.
CLUBKONNECT_USER_ID=
CLUBKONNECT_API_KEY=
FLW_SECRET_KEY=
# Your markup on data bundles, % (change live with ".vtu margin <n>")
VTU_MARGIN=3
# Phase B gateway (not yet active) — ignore for now.
VTU_GATEWAY_URL=
VTU_GATEWAY_KEY=

# ─── Durable operational storage ───────────────────────────
# Render/Koyeb free tiers wipe local files on redeploy. MongoDB mirrors group
# settings, access lists, users, economy, notes, warnings, voice IDs, wallets,
# payments and complete tournament state, then restores everything before
# WhatsApp connects. With AUTH_STATE_SECRET it also stores an encrypted archive
# of creds plus Signal sessions/pre-keys/app-state keys. Tournament creation is
# blocked when MongoDB is offline.
# Keep this secret in host environment variables; never commit the URI.
MONGO_URI=
MONGO_DB=venomxmd

# ─── Sticker ───────────────────────────────────────────────
STICKER_PACK=VENOM-XMD
STICKER_AUTHOR=venom
