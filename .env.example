# ─── VENOM-XMD Configuration ───────────────────────────────
# Copy this file to ".env" and fill in your values.
#
# ★ ONLY TWO THINGS ARE NEEDED TO DEPLOY: ★
#     1) SESSION_ID    2) OWNER_NUMBER
#   Everything else already has sensible defaults — leave it as-is.
# ───────────────────────────────────────────────────────────

# ─── 1) SESSION_ID  (REQUIRED for server deploys) ──────────
# Pair ONCE at:  https://session-site-2odn.onrender.com
# then paste the session ID it gives you here. The bot starts
# pre-authenticated — no QR scan on the server.
#
# Accepts any of:
#   • Short  →  VENOM-XXXX-XXXX          (recommended; permanent, cloud-backed)
#   • Long   →  VENOM~....                (self-contained, works offline)
#   • Plain  →  eyJ...                    (base64 creds, legacy)
SESSION_ID=

# ─── 2) OWNER_NUMBER  (REQUIRED) ───────────────────────────
# Your number(s), international format, no "+", comma-separated.
# Without this you cannot use owner/admin commands. Example:
#   2348012345678,2349087654321
OWNER_NUMBER=

# ═══════════════════════════════════════════════════════════
#  EVERYTHING BELOW IS OPTIONAL — safe to leave untouched.
# ═══════════════════════════════════════════════════════════

# Bot identity
BOT_NAME=VENOM-XMD
PREFIX=.

# Banner image shown at the top of .menu (as the image caption).
# Leave blank to use the bundled assets/logo.png. Set a URL to use your own.
MENU_IMAGE_URL=

# Session site URL — already points at the public VENOM session site.
# Only change this if you self-host your own session generator.
SESSION_SITE_URL=https://session-site-2odn.onrender.com

# Login method (used only when SESSION_ID is blank): "qr" | "pairing" | "both"
LOGIN_METHOD=both

# Phone number for pairing-code login (international format, no "+")
# Required only when LOGIN_METHOD is "pairing" and SESSION_ID is blank.
PAIRING_NUMBER=

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Command cooldown per user (milliseconds)
COOLDOWN_MS=3000

# ─── AI (optional — only for .ai / .translate) ─────────────
# Provider: "openai" (OpenAI-compatible: Groq/OpenRouter/etc.) OR "gemini"
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
# Optional: auto-reply with AI to normal (non-command) DMs. true/false
AI_AUTO_REPLY=false

# ─── Gemini (only if AI_PROVIDER=gemini) ───────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ─── Sticker ───────────────────────────────────────────────
STICKER_PACK=VENOM-XMD
STICKER_AUTHOR=venom
